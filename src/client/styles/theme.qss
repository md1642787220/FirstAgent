/* 焊接设备AI Agent平台 - 深色工业主题 */

QWidget {
    background-color: #0D1117;
    color: #E6EDF3;
    font-family: "Noto Sans", "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow { background-color: #0D1117; }

QMenuBar {
    background-color: #161B22;
    border-bottom: 1px solid #30363D;
    padding: 4px;
}
QMenuBar::item { padding: 6px 16px; border-radius: 4px; }
QMenuBar::item:selected { background-color: #2563EB; }

QTabWidget::pane {
    border: 1px solid #30363D;
    background-color: #0D1117;
    border-radius: 4px;
}
QTabBar::tab {
    background-color: #161B22;
    color: #8B949E;
    padding: 10px 24px;
    margin-right: 2px;
    border: 1px solid #30363D;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    min-width: 100px;
}
QTabBar::tab:selected {
    background-color: #1C2333;
    color: #2563EB;
    border-color: #2563EB;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    background-color: #1C2333;
    color: #E6EDF3;
}

QFrame#cardFrame {
    background-color: #161B22;
    border: 1px solid #30363D;
    border-radius: 8px;
}

QLabel#metricValue { font-size: 28px; font-weight: 700; color: #2563EB; }
QLabel#metricLabel { font-size: 12px; color: #8B949E; font-weight: 500; }
QLabel#metricUnit { font-size: 12px; color: #8B949E; }

QLabel#statusOK { color: #22C55E; font-weight: 600; }
QLabel#statusWarn { color: #F59E0B; font-weight: 600; }
QLabel#statusError { color: #EF4444; font-weight: 600; }
QLabel#statusInfo { color: #3B82F6; font-weight: 600; }

QLabel#sectionTitle { font-size: 16px; font-weight: 600; color: #E6EDF3; padding: 8px 0; }
QLabel#cardTitle { font-size: 14px; font-weight: 500; color: #E6EDF3; }

QPushButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    padding: 8px 20px;
    border-radius: 6px;
    font-weight: 500;
}
QPushButton:hover { background-color: #1D4ED8; }
QPushButton:pressed { background-color: #1E40AF; }
QPushButton#secondaryBtn { background-color: #30363D; color: #E6EDF3; }
QPushButton#secondaryBtn:hover { background-color: #484F58; }

QTableView {
    background-color: #161B22;
    border: 1px solid #30363D;
    border-radius: 4px;
    gridline-color: #30363D;
}
QHeaderView::section {
    background-color: #1C2333;
    color: #8B949E;
    padding: 8px;
    border: none;
    border-right: 1px solid #30363D;
    font-weight: 600;
}
QTableView::item { padding: 6px 8px; border-bottom: 1px solid #21262D; }
QTableView::item:selected { background-color: #2563EB; }

QProgressBar {
    background-color: #21262D;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #E6EDF3;
    height: 20px;
}
QProgressBar::chunk { background-color: #2563EB; border-radius: 4px; }

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #0D1117;
    border: 1px solid #30363D;
    border-radius: 6px;
    padding: 8px 12px;
    color: #E6EDF3;
}
QLineEdit:focus, QTextEdit:focus { border-color: #2563EB; }

QStatusBar {
    background-color: #161B22;
    border-top: 1px solid #30363D;
    color: #8B949E;
}

QScrollBar:vertical { background: #0D1117; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #30363D; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #484F58; }

QFrame#userBubble { background-color: #2563EB; border-radius: 12px; padding: 12px 16px; }
QFrame#agentBubble { background-color: #1C2333; border: 1px solid #30363D; border-radius: 12px; padding: 12px 16px; }

QTreeView {
    background-color: #161B22;
    border: 1px solid #30363D;
    border-radius: 4px;
}
QTreeView::item { padding: 6px; }
QTreeView::item:selected { background-color: #2563EB; }

QComboBox {
    background-color: #161B22;
    border: 1px solid #30363D;
    border-radius: 6px;
    padding: 6px 12px;
    color: #E6EDF3;
}
QComboBox::drop-down { border: none; width: 30px; }
QComboBox QAbstractItemView {
    background-color: #161B22;
    border: 1px solid #30363D;
    selection-background-color: #2563EB;
}

QLabel#agentInsight {
    background-color: #0F4C75;
    border: 1px solid #2563EB;
    border-radius: 8px;
    padding: 10px 14px;
    color: #E6EDF3;
}
