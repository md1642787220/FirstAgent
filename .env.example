# ==================== LLM 模型配置 ====================
# 开发环境：外网直接调用API
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
# 部署环境：改为公司内网模型网关地址
# OPENAI_BASE_URL=http://公司内网模型网关地址/v1
MODEL_NAME=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ==================== 应用配置 ====================
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ==================== 数据库配置 ====================
# SQLite数据库文件路径
SQLITE_PATH=data/welding_agent.db

# ==================== 向量数据库配置 ====================
# Chroma 持久化目录
CHROMA_PERSIST_DIR=data/chroma_db
# 知识文档目录
KNOWLEDGE_DOCS_DIR=data/knowledge_docs

# ==================== LangSmith 追踪（可选） ====================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=welding-agent-platform
